# TAOTAO 配置文件示例
# 复制为 .env 并填入你的真实 Key（.env 已被 .gitignore 排除）

# Agnes AI Hub（必填 - 文本/图片/视频）
# 在 https://agnes-ai.com 申请
AGNES_API_KEY=

# GitHub Models（可选 - 免费额度）
# 在 https://github.com/settings/tokens 申请（不需要任何权限，纯 PAT 占位即可）
GITHUB_TOKEN=

# Groq Cloud（可选 - 快速推理）
# 在 https://console.groq.com 申请
GROQ_API_KEY=
